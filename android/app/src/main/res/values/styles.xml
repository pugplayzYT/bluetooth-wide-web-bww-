<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176B5B</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F7F5</item>
        <item name="android:navigationBarColor">#F4F7F5</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme_Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#58BFA8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121816</item>
        <item name="android:navigationBarColor">#121816</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.Dark" parent="AppTheme_Dark"/>
</resources>
